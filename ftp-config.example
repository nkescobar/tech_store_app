# 🔧 Configuración FTP para TechStore
# Copia este archivo a 'ftp-config' y personaliza con tus datos

# Credenciales FTP de InfinityFree
FTP_HOST="ftpupload.net"
FTP_USER="tu_usuario_infinityfree"
FTP_PASS="tu_password_infinityfree"
REMOTE_PATH="htdocs"

